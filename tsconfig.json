{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "paths": {
      "@pulse-circle/core": ["packages/core/src/index.ts"],
      "@pulse-circle/core/testing": ["packages/core/src/testing.ts"],
      "@pulse-circle/web": ["packages/web/src/index.ts"],
      "@pulse-circle/react-native": ["packages/react-native/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "*.ts"]
}
